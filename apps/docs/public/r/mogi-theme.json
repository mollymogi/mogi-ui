{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "mogi-theme",
  "title": "Mogi Theme",
  "description": "mogi（茉莉花 + 柯基）配色主题，变量名与 shadcn 一致，可直接套用到任意 shadcn 项目。含动效 token（时长、缓动）和减弱动态效果的处理。",
  "cssVars": {
    "theme": {
      "font-sans": "\"JetBrains Mono\", \"Jiangcheng Yuanti\", \"Noto Sans SC\", ui-monospace, monospace",
      "radius": "0.75rem",
      "ease-mogi": "cubic-bezier(0.22, 1, 0.36, 1)",
      "ease-mogi-spring": "cubic-bezier(0.34, 1.4, 0.64, 1)",
      "ease-mogi-in": "cubic-bezier(0.4, 0, 1, 1)",
      "animate-mogi-pop": "mogi-pop var(--duration-mogi-slow) var(--ease-mogi-spring) both"
    },
    "light": {
      "radius": "0.75rem",
      "background": "#f9f3ea",
      "foreground": "#3a2820",
      "card": "#fffdf9",
      "card-foreground": "#3a2820",
      "popover": "#fffdf9",
      "popover-foreground": "#3a2820",
      "primary": "#a65a2a",
      "primary-foreground": "#ffffff",
      "slider-range": "#a65a2a",
      "secondary": "#f9efe3",
      "secondary-foreground": "#6a4c3c",
      "muted": "#f3e8da",
      "muted-foreground": "#765645",
      "accent": "#fae8d3",
      "accent-foreground": "#8c4f2a",
      "destructive": "#a62b3c",
      "destructive-foreground": "#fffaf3",
      "success": "#55702a",
      "success-foreground": "#fffaf3",
      "success-soft": "#e3edc9",
      "warning": "#d9a63a",
      "warning-foreground": "#3a2820",
      "warning-soft": "#fbefcb",
      "highlight": "#984a28",
      "highlight-soft": "#f8ddd0",
      "border": "#e9dccb",
      "input": "#a57e69",
      "ring": "#a65a2a",
      "chart-1": "#c97d45",
      "chart-2": "#7f9a4a",
      "chart-3": "#d98d6a",
      "chart-4": "#d9a63a",
      "chart-5": "#a57e69",
      "sidebar": "#fffdf9",
      "sidebar-foreground": "#3a2820",
      "sidebar-primary": "#a65a2a",
      "sidebar-primary-foreground": "#fffaf3",
      "sidebar-accent": "#fae8d3",
      "sidebar-accent-foreground": "#3a2820",
      "sidebar-border": "#e9dccb",
      "sidebar-ring": "#a65a2a",
      "duration-mogi-fast": "120ms",
      "duration-mogi": "200ms",
      "duration-mogi-slow": "320ms",
      "link": "#a65a2a",
      "border-strong": "#a57e69",
      "ambient-start": "#fdfaf5",
      "ambient-middle": "#faf1e7",
      "ambient-end": "#f3f2e9",
      "glass-tint": "rgb(255 253 249 / 0.8)",
      "glass-border": "#e9dccb",
      "destructive-soft": "#f2e3e1",
      "info": "#2a6176",
      "info-foreground": "#fffaf3",
      "info-soft": "#dcebf0",
      "agent-foreground": "#ffffff",
      "agent-claude": "#bc5332",
      "agent-openai": "#098566",
      "agent-grok": "#18181b",
      "agent-gemini": "#1d63ed",
      "agent-deepseek": "#3b5bdb",
      "agent-opencode": "#334155",
      "agent-dsh": "#0f766e",
      "agent-qwen": "#6d28d9",
      "agent-glm": "#0369a1",
      "agent-kimi": "#4338ca",
      "agent-minimax": "#be123c",
      "agent-hermes": "#b45309",
      "agent-generic": "#475569"
    },
    "dark": {
      "background": "#1e130d",
      "foreground": "#f6ebdd",
      "card": "#2e2017",
      "card-foreground": "#f6ebdd",
      "popover": "#2e2017",
      "popover-foreground": "#f6ebdd",
      "primary": "#a65a2a",
      "primary-foreground": "#ffffff",
      "slider-range": "#dc9357",
      "secondary": "#3a2a1f",
      "secondary-foreground": "#e6d3bf",
      "muted": "#3a2a1f",
      "muted-foreground": "#c4a88f",
      "accent": "#4a3425",
      "accent-foreground": "#f3cfa6",
      "destructive": "#ee9a98",
      "destructive-foreground": "#2a1014",
      "success": "#a3bd6c",
      "success-foreground": "#1d2410",
      "success-soft": "#38481f",
      "warning": "#e6b94f",
      "warning-foreground": "#2a1a10",
      "warning-soft": "#4a3b16",
      "highlight": "#e3a082",
      "highlight-soft": "#4a2e22",
      "border": "#44332a",
      "input": "#a57e69",
      "ring": "#dc9357",
      "chart-1": "#e0a06c",
      "chart-2": "#a3bd6c",
      "chart-3": "#e3a082",
      "chart-4": "#e6b94f",
      "chart-5": "#c4a88f",
      "sidebar": "#2e2017",
      "sidebar-foreground": "#f6ebdd",
      "sidebar-primary": "#e0a06c",
      "sidebar-primary-foreground": "#2a1a10",
      "sidebar-accent": "#4a3425",
      "sidebar-accent-foreground": "#f6ebdd",
      "sidebar-border": "#44332a",
      "sidebar-ring": "#dc9357",
      "link": "#dc9357",
      "border-strong": "#a57e69",
      "ambient-start": "#211917",
      "ambient-middle": "#30201c",
      "ambient-end": "#202822",
      "glass-tint": "rgb(255 255 255 / 0.04)",
      "glass-border": "rgb(255 255 255 / 0.14)",
      "destructive-soft": "#3d2422",
      "info": "#8cc6dc",
      "info-foreground": "#10242c",
      "info-soft": "#1c3640",
      "agent-foreground": "#ffffff",
      "agent-claude": "#bc5332",
      "agent-openai": "#098566",
      "agent-grok": "#27272a",
      "agent-gemini": "#1d63ed",
      "agent-deepseek": "#3b5bdb",
      "agent-opencode": "#334155",
      "agent-dsh": "#0f766e",
      "agent-qwen": "#6d28d9",
      "agent-glm": "#0369a1",
      "agent-kimi": "#4338ca",
      "agent-minimax": "#be123c",
      "agent-hermes": "#b45309",
      "agent-generic": "#475569"
    }
  },
  "css": {
    "@keyframes mogi-pop": {
      "from": {
        "opacity": "0",
        "transform": "scale(0.6)"
      },
      "to": {
        "opacity": "1",
        "transform": "scale(1)"
      }
    },
    "@media (prefers-reduced-motion: reduce)": {
      "*:not(.animate-spin), *::before, *::after": {
        "animation-duration": "1ms !important",
        "animation-delay": "0s !important",
        "animation-iteration-count": "1 !important",
        "transition-duration": "1ms !important",
        "scroll-behavior": "auto !important"
      }
    },
    ":where(.mogi-surface-clean, [data-surface=\"clean\"])": {
      "--background": "#ffffff",
      "--foreground": "#09090b",
      "--card": "#ffffff",
      "--card-foreground": "#09090b",
      "--popover": "#ffffff",
      "--popover-foreground": "#09090b",
      "--link": "#1d4ed8",
      "--primary": "#18181b",
      "--primary-foreground": "#ffffff",
      "--slider-range": "#18181b",
      "--secondary": "#f4f4f5",
      "--secondary-foreground": "#18181b",
      "--muted": "#f4f4f5",
      "--muted-foreground": "#52525b",
      "--accent": "#f4f4f5",
      "--accent-foreground": "#09090b",
      "--destructive": "#b91c1c",
      "--destructive-foreground": "#ffffff",
      "--destructive-soft": "#fef2f2",
      "--info": "#1d4ed8",
      "--info-foreground": "#ffffff",
      "--info-soft": "#eff6ff",
      "--success": "#15803d",
      "--success-foreground": "#ffffff",
      "--success-soft": "#f0fdf4",
      "--warning": "#d9a63a",
      "--warning-foreground": "#3f2a06",
      "--warning-soft": "#fef3c7",
      "--highlight": "#6d28d9",
      "--highlight-soft": "#f5f3ff",
      "--border": "#e4e4e7",
      "--border-strong": "#71717a",
      "--input": "#71717a",
      "--ring": "#18181b",
      "color-scheme": "light"
    },
    ".dark :where(.mogi-surface-clean, [data-surface=\"clean\"]), .dark:where(.mogi-surface-clean, [data-surface=\"clean\"])": {
      "--background": "#09090b",
      "--foreground": "#fafafa",
      "--card": "#111113",
      "--card-foreground": "#fafafa",
      "--popover": "#111113",
      "--popover-foreground": "#fafafa",
      "--link": "#60a5fa",
      "--primary": "#fafafa",
      "--primary-foreground": "#09090b",
      "--slider-range": "#fafafa",
      "--secondary": "#27272a",
      "--secondary-foreground": "#f4f4f5",
      "--muted": "#18181b",
      "--muted-foreground": "#a1a1aa",
      "--accent": "#27272a",
      "--accent-foreground": "#fafafa",
      "--destructive": "#f87171",
      "--destructive-foreground": "#09090b",
      "--destructive-soft": "#3f1515",
      "--info": "#60a5fa",
      "--info-foreground": "#09090b",
      "--info-soft": "#172554",
      "--success": "#4ade80",
      "--success-foreground": "#052e16",
      "--success-soft": "#0f291e",
      "--warning": "#fbbf24",
      "--warning-foreground": "#18181b",
      "--warning-soft": "#422006",
      "--highlight": "#c4b5fd",
      "--highlight-soft": "#2e1065",
      "--border": "#27272a",
      "--border-strong": "#71717a",
      "--input": "#71717a",
      "--ring": "#d4d4d8",
      "color-scheme": "dark"
    }
  },
  "type": "registry:theme"
}