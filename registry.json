          "info-foreground": "#10242c",
          "info-soft": "#1c3640",
          "agent-foreground": "#ffffff",
          "agent-claude": "#bc5332",
          "agent-openai": "#098566",
          "agent-grok": "#27272a",
          "agent-gemini": "#1d63ed",
          "agent-deepseek": "#3b5bdb",
