          "--destructive-soft": "#fef2f2",
          "--info": "#1d4ed8",
          "--info-foreground": "#ffffff",
          "--info-soft": "#eff6ff",
          "--success": "#15803d",
          "--success-foreground": "#ffffff",
          "--success-soft": "#f0fdf4",
          "--warning": "#d9a63a",
          "--warning-foreground": "#3f2a06",
          "--warning-soft": "#fef3c7",
          "--highlight": "#6d28d9",
          "--highlight-soft": "#f5f3ff",
          "--border": "#e4e4e7",
          "--border-strong": "#71717a",
          "--input": "#71717a",
          "--ring": "#18181b",
          "color-scheme": "light"
        },
        ".dark :where(.mogi-surface-clean, [data-surface=\"clean\"]), .dark:where(.mogi-surface-clean, [data-surface=\"clean\"])": {
          "--background": "#09090b",
          "--foreground": "#fafafa",
          "--card": "#111113",
          "--card-foreground": "#fafafa",
          "--popover": "#111113",
