{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "mogi-ui",
  "homepage": "https://github.com/mollymogi/mogi-ui",
  "items": [
    {
      "name": "mogi-theme",
      "type": "registry:theme",
      "title": "Mogi Theme",
      "description": "mogi（茉莉花 + 柯基）配色主题，变量名与 shadcn 一致，可直接套用到任意 shadcn 项目。含动效 token（时长、缓动）和减弱动态效果的处理。",
      "cssVars": {
        "theme": {
          "font-sans": "\"JetBrains Mono\", \"Jiangcheng Yuanti\", \"Noto Sans SC\", ui-monospace, monospace",
          "radius": "0.75rem",
          "ease-mogi": "cubic-bezier(0.22, 1, 0.36, 1)",
          "ease-mogi-spring": "cubic-bezier(0.34, 1.4, 0.64, 1)",
          "ease-mogi-in": "cubic-bezier(0.4, 0, 1, 1)",
          "animate-mogi-pop": "mogi-pop var(--duration-mogi-slow) var(--ease-mogi-spring) both"
        },
        "light": {
          "radius": "0.75rem",
          "background": "#fdfaf5",
          "foreground": "#3a2820",
          "card": "#fffdf9",
          "card-foreground": "#3a2820",
          "popover": "#fffdf9",
          "popover-foreground": "#3a2820",
          "primary": "#a65a2a",
          "primary-foreground": "#ffffff",
          "slider-range": "#a65a2a",
          "secondary": "#f9efe3",
          "secondary-foreground": "#6a4c3c",
          "muted": "#f3e8da",
          "muted-foreground": "#765645",
          "accent": "#fae8d3",
          "accent-foreground": "#8c4f2a",
          "destructive": "#a8402c",
          "destructive-foreground": "#fffaf3",
          "success": "#55702a",
          "success-foreground": "#fffaf3",
          "success-soft": "#e8efd6",
          "warning": "#d9a63a",
          "warning-foreground": "#3a2820",
          "warning-soft": "#fbefc9",
          "highlight": "#984a28",
          "highlight-soft": "#f8ddd0",
          "border": "#e9dccb",
          "input": "#a57e69",
          "ring": "#a65a2a",
          "chart-1": "#c97d45",
          "chart-2": "#7f9a4a",
          "chart-3": "#d98d6a",
          "chart-4": "#d9a63a",
          "chart-5": "#a57e69",
          "sidebar": "#fffdf9",
          "sidebar-foreground": "#3a2820",
          "sidebar-primary": "#a65a2a",
          "sidebar-primary-foreground": "#fffaf3",
          "sidebar-accent": "#fae8d3",
          "sidebar-accent-foreground": "#3a2820",
          "sidebar-border": "#e9dccb",
          "sidebar-ring": "#a65a2a",
          "duration-mogi-fast": "120ms",
          "duration-mogi": "200ms",
          "duration-mogi-slow": "320ms",
          "link": "#a65a2a",
          "border-strong": "#a57e69",
          "ambient-start": "#fdfaf5",
          "ambient-middle": "#faf1e7",
          "ambient-end": "#f3f2e9",
          "glass-tint": "rgb(255 253 249 / 0.8)",
          "glass-border": "#e9dccb"
        },
        "dark": {
          "background": "#241811",
          "foreground": "#f6ebdd",
          "card": "#2e2017",
          "card-foreground": "#f6ebdd",
          "popover": "#2e2017",
          "popover-foreground": "#f6ebdd",
          "primary": "#a65a2a",
          "primary-foreground": "#ffffff",
          "slider-range": "#dc9357",
          "secondary": "#3a2a1f",
          "secondary-foreground": "#e6d3bf",
          "muted": "#3a2a1f",
          "muted-foreground": "#c4a88f",
          "accent": "#4a3425",
          "accent-foreground": "#f3cfa6",
          "destructive": "#e87960",
          "destructive-foreground": "#2a1a10",
          "success": "#a3bd6c",
          "success-foreground": "#1d2410",
          "success-soft": "#33401f",
          "warning": "#e6b94f",
          "warning-foreground": "#2a1a10",
          "warning-soft": "#4a3a12",
          "highlight": "#e3a082",
          "highlight-soft": "#4a2e22",
          "border": "#44332a",
          "input": "#a57e69",
          "ring": "#dc9357",
          "chart-1": "#e0a06c",
          "chart-2": "#a3bd6c",
          "chart-3": "#e3a082",
          "chart-4": "#e6b94f",
          "chart-5": "#c4a88f",
          "sidebar": "#2e2017",
          "sidebar-foreground": "#f6ebdd",
          "sidebar-primary": "#e0a06c",
          "sidebar-primary-foreground": "#2a1a10",
          "sidebar-accent": "#4a3425",
          "sidebar-accent-foreground": "#f6ebdd",
          "sidebar-border": "#44332a",
          "sidebar-ring": "#dc9357",
          "link": "#dc9357",
          "border-strong": "#a57e69",
          "ambient-start": "#211917",
          "ambient-middle": "#30201c",
          "ambient-end": "#202822",
          "glass-tint": "rgb(255 255 255 / 0.04)",
          "glass-border": "rgb(255 255 255 / 0.14)"
        }
      },
      "css": {
        "@keyframes mogi-pop": {
          "from": {
            "opacity": "0",
            "transform": "scale(0.6)"
          },
          "to": {
            "opacity": "1",
            "transform": "scale(1)"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*:not(.animate-spin), *::before, *::after": {
            "animation-duration": "1ms !important",
            "animation-delay": "0s !important",
            "animation-iteration-count": "1 !important",
            "transition-duration": "1ms !important",
            "scroll-behavior": "auto !important"
          }
        }
      }
    },
    {
      "name": "mogi-theme-monochrome",
      "type": "registry:theme",
      "title": "Mogi Monochrome Light",
      "description": "可选黑白浅色主题：白色/浅灰表面、黑色主按钮，保留成功/警告/错误语义色；html 设置 data-palette=\"monochrome\" 并移除 dark。",
      "registryDependencies": [
        "https://mollymogi.github.io/mogi-ui/r/mogi-theme.json"
      ],
      "css": {
        ":root[data-palette=\"monochrome\"]:not(.dark)": {
          "--background": "#fafafa",
          "--foreground": "#171717",
          "--card": "#ffffff",
          "--card-foreground": "#171717",
          "--popover": "#ffffff",
          "--popover-foreground": "#171717",
          "--primary": "#171717",
          "--primary-foreground": "#ffffff",
          "--link": "#262626",
          "--slider-range": "#262626",
          "--secondary": "#f5f5f5",
          "--secondary-foreground": "#404040",
          "--muted": "#f0f0f0",
          "--muted-foreground": "#525252",
          "--accent": "#ededed",
          "--accent-foreground": "#171717",
          "--highlight": "#404040",
          "--highlight-soft": "#e5e5e5",
          "--warning-foreground": "#171717",
          "--border": "#e5e5e5",
          "--border-strong": "#858585",
          "--input": "#858585",
          "--ring": "#737373",
          "--chart-1": "#171717",
          "--chart-2": "#525252",
          "--chart-3": "#737373",
          "--chart-4": "#a3a3a3",
          "--chart-5": "#d4d4d4",
          "--sidebar": "#ffffff",
          "--sidebar-foreground": "#171717",
          "--sidebar-primary": "#171717",
          "--sidebar-primary-foreground": "#ffffff",
          "--sidebar-accent": "#ededed",
          "--sidebar-accent-foreground": "#171717",
          "--sidebar-border": "#e5e5e5",
          "--sidebar-ring": "#737373",
          "--ambient-start": "#ffffff",
          "--ambient-middle": "#f8f8f8",
          "--ambient-end": "#f1f1f1",
          "--glass-tint": "rgb(255 255 255 / 0.9)",
          "--glass-border": "#e5e5e5"
        }
      }
    },
    {
      "name": "mogi-theme-paper",
      "type": "registry:theme",
      "title": "Mogi Cream Paper",
      "description": "奶油纸感浅色主题：奶油底、黄色主按钮、深墨描边和偏移硬阴影。html 设置 data-palette=\"paper\" 并移除 dark。",
      "registryDependencies": [
        "https://mollymogi.github.io/mogi-ui/r/mogi-theme.json"
      ],
      "css": {
        ":root[data-palette=\"paper\"]:not(.dark)": {
          "--background": "#fff7e6",
          "--foreground": "#29251f",
          "--card": "#fffdf6",
          "--card-foreground": "#29251f",
          "--popover": "#fffdf6",
          "--popover-foreground": "#29251f",
          "--primary": "#f8d956",
          "--primary-foreground": "#29251f",
          "--link": "#87471e",
          "--slider-range": "#29251f",
          "--secondary": "#f5ecd9",
          "--secondary-foreground": "#51483d",
          "--muted": "#f1e7d2",
          "--muted-foreground": "#6c6255",
          "--accent": "#faedb4",
          "--accent-foreground": "#29251f",
          "--highlight": "#8c3455",
          "--highlight-soft": "#f5d5df",
          "--warning-foreground": "#29251f",
          "--border": "#d3c7b6",
          "--border-strong": "#8b7c6a",
          "--input": "#8b7c6a",
          "--ring": "#87471e",
          "--sidebar": "#fffdf6",
          "--sidebar-foreground": "#29251f",
          "--sidebar-primary": "#29251f",
          "--sidebar-primary-foreground": "#fffdf6",
          "--sidebar-accent": "#faedb4",
          "--sidebar-accent-foreground": "#29251f",
          "--sidebar-border": "#d3c7b6",
          "--sidebar-ring": "#87471e",
          "--ambient-start": "#fff7e6",
          "--ambient-middle": "#fff9ef",
          "--ambient-end": "#f9f0dd",
          "--glass-tint": "rgb(255 253 246 / 0.9)",
          "--glass-border": "#d3c7b6"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]": {
          "border": "2px solid var(--foreground)",
          "box-shadow": "4px 5px 0 var(--foreground)",
          "transition-property": "background-color, box-shadow, translate",
          "transition-duration": "var(--duration-mogi-fast)",
          "transition-timing-function": "var(--ease-mogi)",
          "scale": "1"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]:not(:disabled):not([aria-disabled=\"true\"]):hover": {
          "translate": "-1px -1px",
          "box-shadow": "5px 6px 0 var(--foreground)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]:not(:disabled):not([aria-disabled=\"true\"]):active": {
          "translate": "3px 4px",
          "box-shadow": "1px 1px 0 var(--foreground)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-glass], :root[data-palette=\"paper\"]:not(.dark) [data-slot=\"card\"]": {
          "border-color": "var(--foreground)",
          "box-shadow": "2px 3px 0 var(--foreground)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"metric-card\"]": {
          "box-shadow": "1px 2px 0 rgb(41 37 31 / 0.12)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"checkbox\"], :root[data-palette=\"paper\"]:not(.dark) [data-slot=\"switch\"]": {
          "border-color": "var(--foreground)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"switch-thumb\"]": {
          "background-color": "var(--foreground)"
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"paper-note\"]": {
          "background-color": "var(--highlight-soft)",
          "color": "var(--foreground)",
          "border": "1px solid var(--foreground)",
          "box-shadow": "3px 4px 0 var(--foreground)",
          "rotate": "-2deg"
        },
        "@media (prefers-reduced-motion: reduce)": {
          ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]:not(:disabled):not([aria-disabled=\"true\"]):hover, :root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]:not(:disabled):not([aria-disabled=\"true\"]):active": {
            "translate": "none"
          }
        },
        ":root[data-palette=\"paper\"]:not(.dark) [data-slot=\"button\"][data-variant=\"default\"]:focus-visible": {
          "outline": "3px solid var(--ring)",
          "outline-offset": "4px"
        }
      }
    }
  ]
}
