{
  "name": "@mogi-ui/ui",
  "version": "0.1.0",
  "description": "Mogi UI components (shadcn/ui based)",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
