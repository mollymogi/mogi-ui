{
  "name": "@mogi-ui/tokens",
  "version": "0.1.0",
  "description": "Mogi UI design tokens: palette, semantic theme (shadcn-compatible) and fonts",
  "license": "MIT",
  "type": "module",
  "files": [
    "src",
    "fonts"
  ],
  "exports": {
    ".": "./src/index.css",
    "./theme.css": "./src/theme.css",
    "./primitives.css": "./src/primitives.css",
    "./fonts.css": "./src/fonts.css",
    "./motion.css": "./src/motion.css",
    "./fonts/*": "./fonts/*",
    "./contrast": {
      "types": "./src/contrast.d.ts",
      "default": "./src/contrast.js"
    }
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.0"
  }
}
